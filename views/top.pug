doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    //- Bootstrapは残しつつ、Google Fontsを追加
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" crossorigin="anonymous")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    //- サイバー系フォント「Orbitron」を追加
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="style.css")
    title NEURAL LINK TERMINAL
  body.cyber-bg.text-light
    //- 上部のナビゲーションバーを「ガラス質感（グラスモフィズム）」に
    nav.navbar.navbar-dark.navbar-glass.mb-5.shadow-lg.sticky-top
      div.container-fluid
        span.navbar-brand.mx-auto.fw-bold.cyber-font 💠 NEURAL LINK TERMINAL
    
    //- メインコンテンツ
    div.container.py-3
      div.row.justify-content-center
        div.col-md-9
          //- 歓迎メッセージパネルをさらにサイバーに
          div.card.bg-glass.mb-5.shadow-lg.border-cyber.cyber-glow-blue
            div.card-body.text-center.py-5
              p.text-cyber-blue.mb-2.cyber-font [ SYSTEM STATUS: ONLINE ]
              h1.display-5.fw-bold.cyber-font 認証完了：#{user}
              p.lead.mt-3 パーソナルAIとの暗号化通信回線、および戦術構築コンソールです。
              
          //- メニューのボタン（2つ並び）
          div.row.g-4
            //- 1. メインチャット
            div.col-sm-6
              div.card.bg-glass.border-cyber.h-100.shadow.cyber-glow-blue.hover-float
                div.card-body.text-center.py-4
                  i.bi.bi-cpu.display-3.text-cyber-blue.mb-4.cyber-glow-icon
                  h3.card-title.cyber-font.mb-3 バディ・コンソール
                  p.card-text.text-secondary.mb-4 AIとの対話、および設定のブレインストーミングを行うメイン回線です。
                  a.btn.btn-cyber-blue.w-100.fw-bold(href="/posts") リンク開始

            //- 2. ログアウト
            div.col-sm-6
              div.card.bg-glass.border-cyber-danger.h-100.shadow.cyber-glow-red.hover-float
                div.card-body.text-center.py-4
                  i.bi.bi-power.display-3.text-cyber-red.mb-4.cyber-glow-icon-red
                  h3.card-title.cyber-font.mb-3 通信切断
                  p.card-text.text-secondary.mb-4 ターミナルから退出して、システムにロックをかけます。
                  a.btn.btn-cyber-red.w-100.fw-bold(href="/logout") ログアウト