doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    // 15秒ごとの自動リロード（バックアップの同期機能）
    meta(http-equiv="refresh" content="20")
    // 独自ファビコンの設定
    link(rel="icon" href="https://cdn-icons-png.flaticon.com/512/2584/2584606.png")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="style.css")
    title NNチャット
  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto NNチャット
          i.bi-chat-dots-fill.ms-1
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{user}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              - const changeThemeText = (currentTheme === 'light' ? 'ダークモードに切り替え' : 'ライトモードに切り替え');
              a.dropdown-item(href="/changeTheme") #{changeThemeText}
              a.dropdown-item(href="/logout") ログアウト
    
    each post in posts
      - const cardClass = (user === post.postedBy ? 'card my-3 border-primary' : 'card my-3')
      div(class=cardClass)
        div.card-body
          div.d-flex.justify-content-between
            h5.card-title #{post.postedBy}
              if post.postedBy === 'admin'
                i.bi-patch-check-fill.ms-1
              if post.postedBy === 'Snowstorm'
                i.bi-robot.ms-1
            - const tooltipTitle = `<small>${post.absoluteCreatedAt}</small>`
            small.card-text.text-muted(data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title=tooltipTitle) #{post.relativeCreatedAt}
          p.card-text.lead #{post.content}
        - const isDeletable = (user === post.postedBy || user === 'admin' || post.postedBy === 'Snowstorm')
        if isDeletable
          div.card-footer.d-flex.justify-content-end
            form(method="post" action="/posts/delete")
              input(type="hidden" name="id" value=post.id)
              input(type="hidden" name="oneTimeToken" value=oneTimeToken)
              button(type="submit").btn.btn-outline-danger.btn-sm
                i.bi-trash

    div(style="height: 150px;")

    div.fixed-bottom.p-4.bg-body
      form(method="post" action="/posts" name="message-form").container-fluid.row.g-3
        div.col-12
          textarea(name="content" rows="4" placeholder="Ctrl(Command)+Enterで送信できます").form-control
          input(type="hidden" name="oneTimeToken" value=oneTimeToken)
        div.col-12
          button(type="submit").btn.btn-primary.float-end
            i.bi-send

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="nn-chat.js")
    script.
      // 1. ページ読み込み時に一番下へスクロール
      window.onload = () => {
        window.scrollTo(0, document.documentElement.scrollHeight);
      };

      // 2. JavaScriptによるリロードなしの非同期更新（快適性）
      const form = document.querySelector('form[name="message-form"]');
      form.onsubmit = async (e) => {
        e.preventDefault(); 
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;

        await fetch('/posts', { method: 'POST', body: new URLSearchParams(formData) });
        form.querySelector('textarea').value = '';

        await new Promise(r => setTimeout(r, 3000));
        const res = await fetch('/api/posts');
        const posts = await res.json();
        
        const lastPost = posts[posts.length - 1];
        const newCard = document.createElement('div');
        newCard.className = 'card my-3';
        newCard.innerHTML = `<div class="card-body"><h5 class="card-title">${lastPost.postedBy}</h5><p class="card-text lead">${lastPost.content}</p></div>`;
        document.body.insertBefore(newCard, document.querySelector('div[style="height: 150px;"]'));
        
        submitBtn.disabled = false;
        window.scrollTo(0, document.body.scrollHeight);
      };